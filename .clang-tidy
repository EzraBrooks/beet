# The analyzer and optional-access checks cannot follow coroutine resumption, so they misreport
# state that the parent task establishes before resuming a child.
# convert-member-functions-to-static would make awaiter members and members whose body differs across
# #if branches static, which breaks the coroutine protocol or the other branch.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-unchecked-optional-access,
  -clang-analyzer-core.uninitialized.Branch,
  -clang-analyzer-deadcode.DeadStores,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -modernize-use-nodiscard,
  -modernize-use-scoped-lock,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -performance-unnecessary-value-param,
  -readability-convert-member-functions-to-static,
CheckOptions:
  readability-identifier-length.IgnoredVariableNames: '^(in|id|ok|fn|ch|at|no|ex)$'
  readability-identifier-length.IgnoredParameterNames: '^(in|id|ok|fn|ch|at|no|ex)$'
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/beet|examples|tests)/.*'
