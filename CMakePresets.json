{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BEET_BUILD_TESTS": "OFF",
        "BEET_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug build of every target, for development and clang-tidy",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BEET_BUILD_TESTS": "ON",
        "BEET_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "examples",
      "displayName": "Release build of the examples and benchmarks",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-examples",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BEET_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "package",
      "displayName": "Install beet to a local prefix the way a packager would",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-package",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BEET_INSTALL": "ON",
        "CMAKE_REQUIRE_FIND_PACKAGE_tl-expected": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-package/prefix"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "examples", "configurePreset": "examples" },
    { "name": "package", "configurePreset": "package" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
  ]
}
